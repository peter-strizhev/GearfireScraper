{"productId": "c3ae14a3-46ba-40d4-85d4-1c78e37dbeb0", "modelName": "CZ455 Scope Base", "modelDescription": "When they set out to build this AREA 419 wanted to solve the problem of CZ455 scope bases that slide around over time. The simple dovetail/set screw bases work for some people but they weren\u2019t happy. This design, made from a single piece of T7075 aluminum and machined in house the AREA 419 Haas VF4SS 4 axis machining center is designed to slide onto the dovetail and be clamped down with a force that is consistent across the entire rail \u2013 and strong enough that your CZ455 will never budge it.  For added security they have added a recoil lug at the rear of the base, creating a mechanical stop for the base. Bases will come Type III black hardcoat anodized and will come with the necessary 2.5mm wrench for torquing the clamp screws.", "manufacturerName": "Area 419", "subProducts": [{"isFirearm": false, "isNfa": false, "subProductId": "67241692-828c-4a4b-9884-a506c2087e97", "description": "Area 419, CZ455 1913 Improved Scope Rail, 7075 Aluminum 30 MOA, Type III Black", "imageUrls": ["https://main-images.gearfire.com/SubProductImages/b24ec416-ae9d-4c81-813d-3b19549076c5", "https://main-images.gearfire.com/SubProductImages/1501f386-35c2-4976-97fb-2a0384221035"], "isDefault": false, "manufacturerPartNumber": "419-ISR-CZ455-30", "upc": "853675008105", "attributes": [{"attributeNameId": "065a46f1-0238-46a2-9ab1-0a2651d75be6", "attributeName": "Color", "attributeValueId": "2d3c3cb6-4e1e-495a-ad76-132d06e11607", "valueName": "Black"}, {"attributeNameId": "b57c3440-3c9b-4bf0-b789-b6cb7a21eea4", "attributeName": "Material", "attributeValueId": "57b6ea8a-79e6-4ad5-9c7f-7ed8694b9182", "valueName": "Aluminum"}, {"attributeNameId": "a81e6b31-4e7d-4010-bc83-da824fed1c76", "attributeName": "Mount Type", "attributeValueId": "9147aaad-08b2-473d-97e3-a911b5ac4109", "valueName": "1913 Picatinny Rail"}], "optionalAttributes": [], "overSized": false, "storeSubProductDataVms": 