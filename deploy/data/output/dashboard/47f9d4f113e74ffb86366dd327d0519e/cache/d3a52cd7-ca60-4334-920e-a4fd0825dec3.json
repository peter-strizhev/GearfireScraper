{"productId": "d3a52cd7-ca60-4334-920e-a4fd0825dec3", "modelName": "Tikka T1X Scope Base", "modelDescription": "Area 419 decided that there were no scope bases on the market that really met their requirements for quality, so they made their own.  Its all in the little details that set this base apart from the competition.  These are machined in house on area419's 4-axis HAAS VMC from 7075 Aluminum.  Straight off the mill there is not a single sharp edge left, all corners are radiused and any necessary harsh corners are chamfered.  Just like all of the other Picatinny products they make, they radius between the slots, and also radius the corners of the lugs to prevent any snag areas and give it a cleaner look.", "manufacturerName": "Area 419", "subProducts": [{"isFirearm": false, "isNfa": false, "subProductId": "5cb4d12c-a846-42a9-b49e-8881016387b5", "description": "Area 419, Tikka T1X SA 1913 Improved Scope Rail, 7075 Aluminum, 30 MOA, Type III Black", "imageUrls": ["https://main-images.gearfire.com/SubProductImages/ec917bed-46f0-4e8d-9734-99774c4df50b", "https://main-images.gearfire.com/SubProductImages/8e8a2211-e24e-41a5-923d-94f8a57f2458"], "isDefault": false, "manufacturerPartNumber": "419-ISR-TKT1X-30", "upc": "850002933154", "attributes": [{"attributeNameId": "b57c3440-3c9b-4bf0-b789-b6cb7a21eea4", "attributeName": "Material", "attributeValueId": "57b6ea8a-79e6-4ad5-9c7f-7ed8694b9182", "valueName": "Aluminum"}, {"attributeNameId": "065a46f1-0238-46a2-9ab1-0a2651d75be6", "attributeName": "Color", "attributeValueId": "2d3c3cb6-4e1e-495a-ad76-132d06e11607", "valueName": "Black"}, {"attributeNameId": "a81e6b31-4e7d-4010-bc83-da824fed1c76", "attributeName": "Mount Type", "attributeValueId": "9147aaad-08b2-473d-97e3-a911b5ac4109", "valueName": "1913 Picatinny Rail"}], "optionalAttributes": [], "overSized": false, "storeSubProductDataVms": [{"storeId": "d55501f3-c636-42b8-989c-1c1003769589", "fullPrice": 63.99, "salePrice": 63.99, "discountStatus": 0, "mapPrice": 60,