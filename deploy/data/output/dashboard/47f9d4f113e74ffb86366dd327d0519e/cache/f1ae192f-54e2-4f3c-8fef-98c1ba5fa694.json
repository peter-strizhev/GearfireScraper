{"productId": "f1ae192f-54e2-4f3c-8fef-98c1ba5fa694", "modelName": "Combat Thermal Mount", "modelDescription": "The compact and lightweight Combat Thermal Mount brings the thermal to an absolute co-witness height of a 1.54\u2033 optical centerline from the rail. With two models, the CTM can be employed for either the Trijicon SkeetIRx or the Pixels on Target VooDoo-S. Using a force-to-overcome mechanism, the thermal flips-to-side. The model for the VooDoo-S can be mounted for both right-and left-handed flip-to-side options. Mounted in front of a compatible weapons optic, CTM mounts directly to an M1913 rail. It comes standard with a FAST QD Lever, allowing the thermal to be used as an HHI (hand held imager) with quick detachment and reattachment while maintaining optic co-alignment.", "manufacturerName": "Unity Tactical", "subProducts": [{"isFirearm": false, "isNfa": false, "subProductId": "c7353b33-2016-4c79-86bc-a2b6b1120795", "description": "Unity Tactical, Combat Thermal Mount, Optic Specific Mount, Fits iRay RH25 Thermal, Anodized Finish, Black", "imageUrls": ["https://main-images.gearfire.com/SubProductImages/81b5d6bd-166a-468d-8fc6-b773a1b65e2f"], "isDefault": true, "manufacturerPartNumber": "OM-TMRB", "upc": "810007884295", "attributes": [{"attributeNameId": "f1b3c83f-8d7a-433d-b33e-6d7f4b0cb32c", "attributeName": "Accessory Type", "attributeValueId": "8b01d47d-7983-4f1c-a6ef-a1adc656cfa5", "valueName": "Mount"}, {"attributeNameId": "065a46f1-0238-46a2-9ab1-0a2651d75be6", "attributeName": "Color", "attributeValueId": "2d3c3cb6-4e1e-495a-ad76-132d06e11607", "valueName": "Black"}, {"attributeNameId": "bc690ee3-3028-4020-a5fc-15938d39c1a2", "attributeName": "Fit / Used For", "attributeValueId": "ce5b5b8d-b55a-4ffb-a990-d0a086595d0b", "valueName": "iRay MICRO"}], "optionalAttributes": [], "overSized": false, "storeSubProductDataVms": [{"storeId": "d55501f3-c636-42b8-989c-1c1003769589", "fullPrice": 470.99, "salePrice": 470.99, "discountStatus": 0, "mapPrice": 44