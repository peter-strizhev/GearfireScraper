{"productId": "2fd1db10-bcb7-41aa-8b39-10a61073ec7e", "modelName": "Remington 700 Scope Base", "modelDescription": "At Area 419 they decided that there were no scope bases on the market that really met requirements for quality, so we made our own.  Its all in the little details that set this base apart from the competition.  These are machined in house on our 4-axis HAAS VMC from 7075 Aluminum.  Straight off the mill there is not a single sharp edge left, all corners are radiused and any necessary harsh corners are chamfered. Just like all of the other Picatinny products they make, we radius between the slots, and also radius the corners of the lugs to prevent any snag areas and give it a cleaner look.", "manufacturerName": "Area 419", "subProducts": [{"isFirearm": false, "isNfa": false, "subProductId": "a0736bfc-201f-4007-bee2-ec00bae1b281", "description": "Area 419, Remington 700 LA 1913 Improved Scope Rail, 7075 Aluminum, 20 MOA, Type III Black", "imageUrls": ["https://main-images.gearfire.com/SubProductImages/ab44225c-211f-4fa3-9b91-a0ce1389a561", "https://main-images.gearfire.com/SubProductImages/305e1fe5-31b2-41e1-aba7-d6d9fa6b20e5"], "isDefault": true, "manufacturerPartNumber": "419-ISR-R700LA-20FS", "upc": "853675008839", "attributes": [{"attributeNameId": "b57c3440-3c9b-4bf0-b789-b6cb7a21eea4", "attributeName": "Material", "attributeValueId": "57b6ea8a-79e6-4ad5-9c7f-7ed8694b9182", "valueName": "Aluminum"}, {"attributeNameId": "a81e6b31-4e7d-4010-bc83-da824fed1c76", "attributeName": "Mount Type", "attributeValueId": "9147aaad-08b2-473d-97e3-a911b5ac4109", "valueName": "1913 Picatinny Rail"}, {"attributeNameId": "065a46f1-0238-46a2-9ab1-0a2651d75be6", "attributeName": "Color", "attributeValueId": "2d3c3cb6-4e1e-495a-ad76-132d06e11607", "valueName": "Black"}], "optionalAttributes": [], "overSized": false, "storeSubProductDataVms": [{"storeId": "d55501f3-c636-42b8-989c-1c1003769589", "fullPrice": 106.99, "salePrice": 106.99, "discountStatus": 0, "mapPrice": 10