{"productId": "a023703f-38ca-404c-8df1-ddc5dcdcd789", "modelName": "Improved Scope Rail", "modelDescription": "At Area 419 we decided that there were no scope bases on the market that really met our requirements for quality, so we made our own.  Its all in the little details that set this base apart from the competition.  These are machined in house on our 4-axis HAAS VMC from 7075 Aluminum.  Straight off the mill there is not a single sharp edge left, all corners are radiused and any necessary harsh corners are chamfered.  Just like all of the other Picatinny products we make, we radius between the slots, and also radius the corners of the lugs to prevent any snag areas and give it a cleaner look.", "manufacturerName": "Area 419", "subProducts": [{"isFirearm": false, "isNfa": false, "subProductId": "0116499b-1053-4869-a39c-6210f36a95b2", "description": "Area 419, Improved Scope Rail, MIL-STD 1913, Black Aluminum, Fits Browning X-Bolt Short Action, 20 MOA", "imageUrls": ["https://main-images.gearfire.com/SubProductImages/a29a3119-0cf4-422b-aae4-8ce7559195cf"], "isDefault": false, "manufacturerPartNumber": "419-ISR-XBLTSA", "upc": "810080183087", "attributes": [{"attributeNameId": "b57c3440-3c9b-4bf0-b789-b6cb7a21eea4", "attributeName": "Material", "attributeValueId": "57b6ea8a-79e6-4ad5-9c7f-7ed8694b9182", "valueName": "Aluminum"}, {"attributeNameId": "a81e6b31-4e7d-4010-bc83-da824fed1c76", "attributeName": "Mount Type", "attributeValueId": "9147aaad-08b2-473d-97e3-a911b5ac4109", "valueName": "1913 Picatinny Rail"}, {"attributeNameId": "065a46f1-0238-46a2-9ab1-0a2651d75be6", "attributeName": "Color", "attributeValueId": "2d3c3cb6-4e1e-495a-ad76-132d06e11607", "valueName": "Black"}], "optionalAttributes": [], "overSized": false, "storeSubProductDataVms": [{"storeId": "d55501f3-c636-42b8-989c-1c1003769589", "fullPrice": 106.99, "salePrice": 106.99, "discountStatus": 0, "mapPrice": 100, "addToCartToSeePrice": false, "quantityOnHand": 4, "inStoreOnly": false, "distribut