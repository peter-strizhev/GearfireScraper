{"productId": "8892896a-ad0c-4f2e-a41f-1b46be1db830", "modelName": "MICRO MQD", "modelDescription": "The counterpart to the dovetail side of the PICTAIL shoe is MIL-STD-1913 picatinny rail specially designed with one slot that interfaces with the ADM MQD mount. The PICTAIL and MQD mount work in tandem to achieve an adjustable footprint on any standard picatinny rail. In standalone optic mode they produce over 4.5 inches of rear offset, and when reversed for use in clip-on mode the MQD and PICTAIL shrink the rear offset to just 1.5 inches. In clip-on mode the required forward rail space is just 4 rail slots in front of a day optic making the PICTAIL and MQD the perfect combination for shorter platforms like SBRs and pistols.", "manufacturerName": "iRay USA", "subProducts": [{"isFirearm": false, "isNfa": false, "subProductId": "78091d3b-8dc2-421c-b330-a6f4f94bca07", "description": "iRay USA, RICO MICRO MQD Mount, For Pistol/SBR Black", "imageUrls": ["https://main-images.gearfire.com/SubProductImages/0a689fa7-07d1-4916-9c7d-e4f4568496c8"], "isDefault": true, "manufacturerPartNumber": "IRAY-AC36", "upc": "850029093480", "attributes": [{"attributeNameId": "a81e6b31-4e7d-4010-bc83-da824fed1c76", "attributeName": "Mount Type", "attributeValueId": "bbe8430e-df0b-4345-9e14-90bd2fc31cee", "valueName": "Quick Release"}, {"attributeNameId": "065a46f1-0238-46a2-9ab1-0a2651d75be6", "attributeName": "Color", "attributeValueId": "2d3c3cb6-4e1e-495a-ad76-132d06e11607", "valueName": "Black"}, {"attributeNameId": "b57c3440-3c9b-4bf0-b789-b6cb7a21eea4", "attributeName": "Material", "attributeValueId": "57b6ea8a-79e6-4ad5-9c7f-7ed8694b9182", "valueName": "Aluminum"}], "optionalAttributes": [], "overSized": false, "storeSubProductDataVms": [{"storeId": "d55501f3-c636-42b8-989c-1c1003769589", "fullPrice": 211.99, "salePrice": 211.99, "discountStatus": 0, "mapPrice": 199, "addToCartToSeePrice": false, "quantityOnHand": 3, "inStoreOnly": false, "distributorId": "26057733-ffaf-4414-80a7-5c86